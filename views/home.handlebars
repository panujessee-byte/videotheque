<section>
    <h2>Ajouter un film</h2>

    <form id="form-film" novalidate>
        <div class="champ">
            <label for="input-titre">Titre</label>
            <input type="text" id="input-titre">
            <div class="erreur" id="erreur-titre"></div>
        </div>

        <div class="champ">
            <label for="input-genre">Genre</label>
            <input type="text" id="input-genre">
            <div class="erreur" id="erreur-genre"></div>
        </div>

        <div class="champ">
            <label for="input-annee">Année</label>
            <input type="number" id="input-annee">
            <div class="erreur" id="erreur-annee"></div>
        </div>

        <div class="champ">
            <label for="input-note">Note (1 à 5)</label>
            <input type="number" id="input-note">
            <div class="erreur" id="erreur-note"></div>
        </div>

        <button type="submit">Ajouter</button>
    </form>
</section>

<section>
    <h2>Mes films</h2>

    <ul id="liste-films">
        {{#each films}}
            {{> film this}}
        {{/each}}
    </ul>
</section>
