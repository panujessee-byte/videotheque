<li class="film" data-id-film="{{this.id_film}}" data-vu="{{this.est_vu}}">
    <div class="film-info">
        <h3>{{this.titre}}</h3>
        <p>{{this.genre}} - {{this.annee}} - Note : {{this.note}}/5</p>
    </div>

    <div class="film-actions">
        {{#if this.est_vu}}
            <span class="film-etat">Vu</span>
            <button type="button" class="film-vu" data-id-film="{{this.id_film}}">Marquer comme pas vu</button>
        {{else}}
            <span class="film-etat">Pas vu</span>
            <button type="button" class="film-vu" data-id-film="{{this.id_film}}">Marquer comme vu</button>
        {{/if}}

        <button type="button" class="film-supprimer" data-id-film="{{this.id_film}}">Supprimer</button>
    </div>
</li>
