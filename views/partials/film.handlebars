<li class="film" data-id="{{id_film}}" data-vu="{{est_vu}}">
    <div class="film-info">
        <h3>{{titre}}</h3>
        <p>{{genre}} - {{annee}} - Note : {{note}}/5</p>
    </div>

    <div class="film-actions">
        {{#if est_vu}}
            <span class="film-etat">Vu</span>
            <button type="button" class="film-vu">Marquer comme pas vu</button>
        {{else}}
            <span class="film-etat">Pas vu</span>
            <button type="button" class="film-vu">Marquer comme vu</button>
        {{/if}}

        <button type="button" class="film-supprimer">Supprimer</button>
    </div>
</li>
